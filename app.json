{
  "expo": {
    "name": "taskflow-app",
    "slug": "taskflow-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090A",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.llescano.taskflowapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "TaskFlow necesita acceder a tus fotos para que elijas una imagen de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d310086b-2057-412f-8d8a-56e094c9b04f"
      }
    },
    "owner": "llescano",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d310086b-2057-412f-8d8a-56e094c9b04f"
    }
  }
}
